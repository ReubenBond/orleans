<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    An Orleans silo whose journaled grains store their state in Clog: its node's disk under DurableStorage:Node:Root, its MetaStore
    and LSM object store in Azure Storage, Orleans' membership in Azure Table storage. samples/Orleans.Durable.Storage.Samples.AppHost runs
    three of them on Azurite.
  -->
  <PropertyGroup>
    <RootNamespace>Orleans.Durable.Storage.Samples.Journaling</RootNamespace>

    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Durable.Storage.AzureStorage\Orleans.Durable.Storage.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage\Orleans.Durable.Storage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Clustering.AzureStorage\Orleans.Clustering.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable\Orleans.Durable.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Runtime\Orleans.Runtime.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Sdk\Orleans.Sdk.csproj" />
  </ItemGroup>
</Project>
