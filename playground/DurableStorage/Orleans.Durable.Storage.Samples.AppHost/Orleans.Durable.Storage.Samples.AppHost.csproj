<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" />

  <!-- Runs samples/Orleans.Durable.Storage.Samples.Journaling as three silos over Azurite, with the Aspire dashboard (just sample). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>

  <!-- The emulators' images, pinned by digest once for both AppHosts (build-packaging.md §2). -->
  <ItemGroup>
    <Compile Include="..\..\apphost\shared\EmulatorImages.cs" Link="EmulatorImages.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.Durable.Storage.Samples.Journaling\Orleans.Durable.Storage.Samples.Journaling.csproj" />
  </ItemGroup>
</Project>
