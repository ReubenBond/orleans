{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Information",
      "Orleans.Runtime.Management": "Warning"
    }
  },
  "Bench": {
    "Mode": "Clog",
    "ClusterId": "durable-storage-bench",
    "ServiceId": "durable-storage-bench",
    "SiloPort": 11111,
    "GatewayPort": 30000,
    "HttpPort": 8080,
    "Storage": {
      "LsmContainer": "lsm",
      "JobsContainer": "jobs",
      "BaselineJournalsContainer": "journals",
      "ResultsContainer": "results",
      "CreateContainersIfNotExists": true
    }
  },
  "CasPaxosBench": {
    "ConsensusDir": "/mnt/nvme/consensus",
    "DnsResolveTimeoutSeconds": 180
  },
  "DurableStorage": {
    "Node": {
      "Root": "/mnt/nvme/clog",
      "ArchiveStore": "Lsm"
    },
    "Control": {
      "Replicas": 3
    }
  }
}
