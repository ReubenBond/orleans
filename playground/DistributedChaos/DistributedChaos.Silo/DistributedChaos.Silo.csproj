<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <IsPublishable>true</IsPublishable>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>chaos-silo</ContainerRepository>
    <NoWarn>$(NoWarn);ORLEANSEXP002;ORLEANSEXP003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\src\AdoNet\Shared\SQLServer-*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\src\AdoNet\Orleans.Clustering.AdoNet\Migrations\SQLServer-*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\src\AdoNet\Orleans.Clustering.AdoNet\SQLServer-*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AdoNet\Orleans.Clustering.AdoNet\Orleans.Clustering.AdoNet.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Core.Abstractions\Orleans.Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Core\Orleans.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Hosting.Kubernetes\Orleans.Hosting.Kubernetes.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Reminders\Orleans.Reminders.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Runtime\Orleans.Runtime.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Sdk\Orleans.Sdk.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Serialization.Abstractions\Orleans.Serialization.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Serialization\Orleans.Serialization.csproj" />
    <ProjectReference Include="..\..\..\src\Orleans.Server\Orleans.Server.csproj" />
    <ProjectReference Include="..\..\..\src\Redis\Orleans.Clustering.Redis\Orleans.Clustering.Redis.csproj" />
    <ProjectReference Include="..\DistributedChaos.Contracts\DistributedChaos.Contracts.csproj" />
    <ProjectReference Include="..\DistributedChaos.ServiceDefaults\DistributedChaos.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="OrleansDashboard" />
    <PackageReference Include="System.Data.SqlClient" />
  </ItemGroup>

</Project>
