@page "/fetchdata"
@using DashboardToy.Frontend.Data
@inject ClusterDiagnosticsService ClusterDiagnosticsService
@inject IJSRuntime JSRuntime

<PageTitle>Weather forecast</PageTitle>

<h1>Grain call frequencies</h1>
<div id="callGraphContainer">
    <svg width="1200" height="900">
        <g class="links"></g>
        <g class="nodes"></g>
    </svg>
</div>
 <style>
circle {
  fill: cadetblue;
}
line {
  stroke: #ccc;
}
text {
  text-anchor: middle;
  font-family: "Helvetica Neue", Helvetica, sans-serif;
  fill: #666;
  font-size: 16px;
}
 </style>
<script type="text/javascript">
    var width = 800, height = 600;

    function onData(graphData) {
        console.log("Received JSON:", graphData);
        var nodes = graphData.grainIds;
        var links = graphData.edges;

var simulation = d3.forceSimulation(nodes)
	.force('charge', d3.forceManyBody().strength(-800))
	.force('center', d3.forceCenter(width / 2, height / 2))
	.force('link', d3.forceLink().links(links))
	.on('tick', ticked);

function updateLinks() {
	var u = d3.select('.links')
		.selectAll('line')
		.data(links)
		.join('line')
		.attr('x1', function(d) {
			return d.source.x
		})
		.attr('y1', function(d) {
			return d.source.y
		})
		.attr('x2', function(d) {
			return d.target.x
		})
		.attr('y2', function(d) {
			return d.target.y
		});
}

function updateNodes() {
	u = d3.select('.nodes')
		.selectAll('text')
		.data(nodes)
		.join('text')
		.text(function(d) {
			return d.name
		})
		.attr('x', function(d) {
			return d.x
		})
		.attr('y', function(d) {
			return d.y
		})
		.attr('dy', function(d) {
			return 5
		});
}

function ticked() {
	updateLinks()
	updateNodes()
}

