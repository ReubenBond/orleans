        for (var i in graphData.grainIds) {
            var grainId = graphData.grainIds[i];
            graph.addNode(i, { label: grainId, x: Math.random(), y: Math.random(), size: 10, forceLabel: true });
        }
        for (var i in graphData.edges) {
            var edge = graphData.edges[i];
            graph.addEdge(edge.sourceId, edge.targetId, { forceLabel: true, label: edge.callCount, size: 3, type: 'curved' });
        }
    const sigmaInstance = new Sigma(graph, document.getElementById("callGraphContainer"));
    */
    }
</script>


@if (callGraph == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Source Grain</th>
                <th>Source Host</th>
                <th>Target Grain</th>
                <th>Target Host</th>
                <th>Count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var edge in callGraph.Edges)
            {
                <tr>
                    <td>@callGraph.GrainIds[edge.Source]</td>
                    <td>@callGraph.HostIds[edge.SourceHost]</td>
                    <td>@callGraph.GrainIds[edge.Target]</td>
                    <td>@callGraph.HostIds[edge.TargetHost]</td>
                    <td>@edge.Distance</td>
                </tr>
            }
        </tbody>
    </table>

}

@code {
    private CallGraph? callGraph;

    protected override async Task OnInitializedAsync()
    {
        callGraph = await ClusterDiagnosticsService.GetGrainCallFrequencies();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        callGraph ??= await ClusterDiagnosticsService.GetGrainCallFrequencies();
        await JSRuntime.InvokeVoidAsync("onData", callGraph); 
    }
}
