<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The cloud providers against the emulators of apphost/Orleans.Durable.Storage.AppHost, which the tests start through Aspire's testing
    host when CLOG_EMULATORS is 1 (just emulators), at milestones (docs/spec/verification.md §10); otherwise those tests
    skip, and the provider tests which need no emulator run. The Debug leg runs them in Debug, where Orleans.Durable.Storage.Engine.Buffers poisons
    each page as it returns to its pool, so an upload which read its content after its lease ended would send the poison.
  -->
  <PropertyGroup>
    <ClogDebugLeg>true</ClogDebugLeg>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Accordant" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\apphost\Orleans.Durable.Storage.AppHost\Orleans.Durable.Storage.AppHost.csproj" />
    <ProjectReference Include="$(SourceRoot)src\AWS\Orleans.Durable.Storage.S3\Orleans.Durable.Storage.S3.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Durable.Storage.AzureStorage\Orleans.Durable.Storage.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Google\Orleans.Durable.Storage.GoogleCloud\Orleans.Durable.Storage.GoogleCloud.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\Archive\Lsm\ObjectStoreContract.cs" Link="Archive\ObjectStoreContract.cs" />
    <Compile Include="..\shared\Archive\Lsm\FaultInjectingObjectStore.cs" Link="Archive\FaultInjectingObjectStore.cs" />
    <Compile Include="..\shared\Cloud\*.cs" LinkBase="Cloud" />
    <Compile Include="..\shared\Conformance\*.cs" LinkBase="Conformance\Kit" />
    <Compile Include="..\shared\Conformance\Archive\Lsm\*.cs" LinkBase="Conformance\Kit\Archive" />
    <Compile Include="..\shared\Conformance\Archive\Logs\*.cs" LinkBase="Conformance\Kit\Archive\Logs" />
    <Compile Include="..\shared\Conformance\Ledger\*.cs" LinkBase="Conformance\Kit\Ledger" />
    <Compile Include="..\shared\Conformance\LedgerComposition\LedgerConformanceOperations.cs" Link="Conformance\Kit\Ledger\LedgerConformanceOperations.cs" />
    <Compile Include="..\shared\Conformance\LedgerComposition\ObjectLedgerSystem.cs" Link="Conformance\Kit\Ledger\ObjectLedgerSystem.cs" />
    <Compile Include="..\shared\ReplicaAnswers.cs" Link="Conformance\Kit\Ledger\ReplicaAnswers.cs" />
    <Compile Include="..\shared\LedgerAppends.cs" Link="Conformance\Kit\Ledger\LedgerAppends.cs" />
    <Compile Include="..\shared\Archive\Logs\ArchiveLogDrains.cs" Link="Archive\Logs\ArchiveLogDrains.cs" />
    <Compile Include="..\shared\Archive\KeyedRow.cs" Link="Archive\KeyedRow.cs" />
    <Compile Include="..\shared\LeakChecks\*.cs" Exclude="..\shared\LeakChecks\SimulationLeakCheck.cs" LinkBase="LeakChecks" />
  </ItemGroup>
</Project>