<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Debug leg runs these tests in Debug, where Orleans.Durable.Storage.Engine.Buffers poisons each page as it returns to its pool, so a provider
    which read a write's value after the write completed would land the poison (docs/spec/verification.md §12).
  -->
  <PropertyGroup>
    <ClogDebugLeg>true</ClogDebugLeg>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Accordant" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\ConditionalRegisterContract.cs" Link="ConditionalRegisterContract.cs" />
    <Compile Include="..\shared\ConditionalRegisterWrites.cs" Link="ConditionalRegisterWrites.cs" />
    <Compile Include="..\shared\Conformance\MetaStore\*.cs" LinkBase="Conformance\MetaStore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\AWS\Orleans.Durable.Storage.S3\Orleans.Durable.Storage.S3.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Durable.Storage.AzureStorage\Orleans.Durable.Storage.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.FileSystem\Orleans.Durable.Storage.FileSystem.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Google\Orleans.Durable.Storage.GoogleCloud\Orleans.Durable.Storage.GoogleCloud.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\LeakChecks\*.cs" Exclude="..\shared\LeakChecks\SimulationLeakCheck.cs" LinkBase="LeakChecks" />
    <Compile Include="..\shared\CrashStates\*.cs" LinkBase="CrashStates" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fuzz\Orleans.Durable.Storage.Fuzz.MetaStore\Orleans.Durable.Storage.Fuzz.MetaStore.csproj" />
    <Compile Include="..\shared\CorpusReplay.cs" Link="CorpusReplay.cs" />
    <Compile Include="..\shared\SharedVectors.cs" Link="SharedVectors.cs" />
  </ItemGroup>
</Project>
