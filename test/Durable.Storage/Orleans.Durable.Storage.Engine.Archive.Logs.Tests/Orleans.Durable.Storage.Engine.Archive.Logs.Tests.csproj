<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Debug leg runs the packer's debug assertions here, and checks that no page is read after its buffer's release
    (test/Durable.Storage/docs/spec/verification.md §12).
  -->
  <PropertyGroup>
    <ClogDebugLeg>true</ClogDebugLeg>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Accordant" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <!-- A direct reference, so that Orleans.Durable.Storage.Engine.Archive's mutation testing reaches the tests which cover it. -->
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
    <!-- The store's record lies in the LSM's memory object store; the Azure store runs over the fake transport. -->
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Durable.Storage.AzureStorage\Orleans.Durable.Storage.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.FileSystem\Orleans.Durable.Storage.FileSystem.csproj" />
    <!-- The shared archive suites run their ledger maps over the memory register. -->
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\SharedVectors.cs" Link="SharedVectors.cs" />
    <Compile Include="..\shared\SnapshotSettings.cs" Link="SnapshotSettings.cs" />
    <Compile Include="..\shared\Archive\*.cs" LinkBase="Archive" />
    <Compile Include="..\shared\Archive\Objects\*.cs" LinkBase="Archive\Objects" />
    <Compile Include="..\shared\Archive\Logs\*.cs" LinkBase="Archive\Logs" />
    <Compile Include="..\shared\Archive\Lsm\FaultInjectingObjectStore.cs" Link="Archive\Lsm\FaultInjectingObjectStore.cs" />
    <Compile Include="..\shared\CrashStates\*.cs" LinkBase="CrashStates" />
    <Compile Include="..\shared\LedgerProposals.cs" Link="LedgerProposals.cs" />
    <Compile Include="..\shared\Conformance\ConformanceKit.cs" Link="Conformance\Kit\ConformanceKit.cs" />
    <Compile Include="..\shared\Conformance\Archive\Logs\*.cs" LinkBase="Conformance\Kit\Archive\Logs" />
    <Compile Include="..\shared\LeakChecks\*.cs" Exclude="..\shared\LeakChecks\SimulationLeakCheck.cs" LinkBase="LeakChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fuzz\Orleans.Durable.Storage.Fuzz.Archive.Logs\Orleans.Durable.Storage.Fuzz.Archive.Logs.csproj" />
    <Compile Include="..\shared\CorpusReplay.cs" Link="CorpusReplay.cs" />
  </ItemGroup>
</Project>
