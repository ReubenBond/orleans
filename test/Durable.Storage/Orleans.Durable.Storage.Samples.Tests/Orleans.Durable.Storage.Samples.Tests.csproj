<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The smoke test of samples/Orleans.Durable.Storage.Samples.Journaling: its silo configuration, over in-memory stores, starts a cluster in
    which a grain's state survives its silo's death and restart. It sees the composition only through its public surface.
  -->
  <PropertyGroup>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.TestingHost\Orleans.TestingHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)playground\DurableStorage\Orleans.Durable.Storage.Samples.Journaling\Orleans.Durable.Storage.Samples.Journaling.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
  </ItemGroup>
</Project>
