<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Debug leg runs the ledger's, the sequencer's, the slot checkpoints', and the batch codec's debug assertions here
    (test/Durable.Storage/docs/spec/verification.md §12).
  -->
  <PropertyGroup>
    <DurableStorageDebugLeg>true</DurableStorageDebugLeg>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Accordant" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\SharedVectors.cs" Link="SharedVectors.cs" />
    <Compile Include="..\shared\SnapshotSettings.cs" Link="SnapshotSettings.cs" />
    <Compile Include="..\shared\CrashStates\*.cs" LinkBase="CrashStates" />
    <Compile Include="..\shared\Conformance\*.cs" LinkBase="Conformance\Kit" />
    <Compile Include="..\shared\Conformance\LedgerReplica\*.cs" LinkBase="Conformance\Kit\LedgerReplica" />
    <Compile Include="..\shared\Conformance\LedgerComposition\*.cs" LinkBase="Conformance\Kit\LedgerComposition" />
    <Compile Include="..\shared\Conformance\Ledger\*.cs" LinkBase="Conformance\Kit\Ledger" />
    <Compile Include="..\shared\Linearizability\HistoryOperation.cs;..\shared\Linearizability\HistoryRecorder.cs" LinkBase="Linearizability" />
    <Compile Include="..\shared\Recording\*.cs" LinkBase="Recording" />
    <Compile Include="..\shared\UnionLaws\*.cs" LinkBase="UnionLaws" />
    <Compile Include="..\shared\Conformance\Ledgers\*.cs" LinkBase="Conformance\Kit\Ledgers" />
    <Compile Include="..\shared\Archive\Lsm\FaultInjectingObjectStore.cs" Link="Objects\FaultInjectingObjectStore.cs" />
    <Compile Include="..\shared\AssertingLedgerReplica.cs" Link="AssertingLedgerReplica.cs" />
    <Compile Include="..\shared\ReplicaAnswers.cs" Link="ReplicaAnswers.cs" />
    <Compile Include="..\shared\LedgerProposals.cs" Link="LedgerProposals.cs" />
    <Compile Include="..\shared\ScriptedConditionalRegister.cs" Link="ScriptedConditionalRegister.cs" />
    <Compile Include="..\shared\LedgerAppends.cs" Link="LedgerAppends.cs" />
    <Compile Include="..\shared\CallBudgetMutants.cs" Link="CallBudgetMutants.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\LeakChecks\*.cs" Exclude="..\shared\LeakChecks\SimulationLeakCheck.cs" LinkBase="LeakChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fuzz\Orleans.Durable.Storage.Fuzz.Ledgers\Orleans.Durable.Storage.Fuzz.Ledgers.csproj" />
    <Compile Include="..\shared\CorpusReplay.cs" Link="CorpusReplay.cs" />
  </ItemGroup>
</Project>
