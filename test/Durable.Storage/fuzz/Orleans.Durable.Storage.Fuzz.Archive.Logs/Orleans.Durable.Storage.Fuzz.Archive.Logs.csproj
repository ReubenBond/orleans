<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The fuzz targets of archive logs' formats (docs/spec/verification.md §6.1, archive-logs.md §10): the token codec in
    Orleans.Durable.Storage.Engine.Archive.Logs and Azure's metadata reader in Orleans.Durable.Storage.AzureStorage. Archive logs' tests replay their corpora.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Orleans.Durable.Storage.Fuzz.Abstractions\Orleans.Durable.Storage.Fuzz.Abstractions.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Durable.Storage.AzureStorage\Orleans.Durable.Storage.AzureStorage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Archive logs' tests judge the codecs against the rules' readings too. -->
    <InternalsVisibleTo Include="Orleans.Durable.Storage.Engine.Archive.Logs.Tests" />
  </ItemGroup>
</Project>
