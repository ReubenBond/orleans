<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The fuzz targets of the Orleans composition's formats, the node registry and the journal and replica node grains' answers
    (test/Durable.Storage/docs/spec/verification.md §6.1). It references the composition, which decodes them; the composition's tests replay
    their corpora.
  -->
  <ItemGroup>
    <Using Include="Orleans.Serialization.Buffers.ArcBuffer" Alias="OrleansBuffer" />
    <Using Include="Orleans.Serialization.Buffers.ArcBufferWriter" Alias="OrleansBufferWriter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orleans.Durable.Storage.Fuzz.Abstractions\Orleans.Durable.Storage.Fuzz.Abstractions.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage\Orleans.Durable.Storage.csproj" />
  </ItemGroup>
</Project>
