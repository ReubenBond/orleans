    replay their corpora and use their readings of the formats' rules as oracles.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Orleans.Durable.Storage.Fuzz.Abstractions\Orleans.Durable.Storage.Fuzz.Abstractions.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The archive's tests judge decoded run objects by the target's comparison with the rules' reading. -->
    <InternalsVisibleTo Include="Orleans.Durable.Storage.Engine.Archive.Lsm.Tests" />
  </ItemGroup>
</Project>
