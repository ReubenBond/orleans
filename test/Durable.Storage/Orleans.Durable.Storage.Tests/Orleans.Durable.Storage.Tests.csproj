<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Debug leg runs the node registry committer's and the replica host's debug assertions here (test/Durable.Storage/docs/spec/verification.md §12).
  -->
  <PropertyGroup>
    <ClogDebugLeg>true</ClogDebugLeg>

    <!-- The multi-silo tests over both archive stores take more than the default session's 12 minutes under the full suite. -->
    <ClogTestSessionTimeout>25m</ClogTestSessionTimeout>

    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Accordant" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Durable.Storage.AzureStorage\Orleans.Durable.Storage.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.CasPaxos\Orleans.Durable.Storage.CasPaxos.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.FileSystem\Orleans.Durable.Storage.FileSystem.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.RocksDb\Orleans.Durable.Storage.RocksDb.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage\Orleans.Durable.Storage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.TestingHost\Orleans.TestingHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\SharedVectors.cs" Link="SharedVectors.cs" />
    <Compile Include="..\shared\SnapshotSettings.cs" Link="SnapshotSettings.cs" />
    <Compile Include="..\shared\ScriptedConditionalRegister.cs" Link="ScriptedConditionalRegister.cs" />
    <Compile Include="..\shared\ReplicaChoice.cs" Link="ReplicaChoice.cs" />
    <Compile Include="..\shared\CallBudgetMutants.cs" Link="CallBudgetMutants.cs" />
    <Compile Include="..\shared\Archive\Logs\FakeAzureBlobService.cs" Link="Archive\FakeAzureBlobService.cs" />
    <Compile Include="..\shared\Conformance\*.cs" LinkBase="Conformance\Kit" />
    <Compile Include="..\shared\Conformance\LedgerReplica\*.cs" LinkBase="Conformance\Kit\LedgerReplica" />
    <Compile Include="..\shared\Conformance\Orleans\*.cs" LinkBase="Conformance\Kit\Orleans" />
    <Compile Include="..\shared\LeakChecks\*.cs" Exclude="..\shared\LeakChecks\SimulationLeakCheck.cs" LinkBase="LeakChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fuzz\Orleans.Durable.Storage.Fuzz.Orleans\Orleans.Durable.Storage.Fuzz.Orleans.csproj" />
    <Compile Include="..\shared\CorpusReplay.cs" Link="CorpusReplay.cs" />
    <Compile Include="..\shared\LedgerProposals.cs" Link="LedgerProposals.cs" />
  </ItemGroup>

  <!-- The multi-silo workloads' histories are checked with the linearizability checker, which runs in the test host. -->
  <ItemGroup>
    <Compile Include="..\shared\Linearizability\*.cs" LinkBase="Linearizability" />
    <EmbeddedResource Include="..\shared\Linearizability\Visualization\*"
                      LinkBase="Linearizability\Visualization"
                      LogicalName="Orleans.Durable.Storage.Testing.Linearizability.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Orleans' own buffer, which the replica calls' grain messages carry (orleans.md §5.12), has one name here, so a bare
    ArcBuffer always means Clog's.
  -->
  <ItemGroup>
    <Using Include="Orleans.Serialization.Buffers.ArcBuffer" Alias="OrleansBuffer" />
    <Using Include="Orleans.Serialization.Buffers.ArcBufferWriter" Alias="OrleansBufferWriter" />
  </ItemGroup>
</Project>