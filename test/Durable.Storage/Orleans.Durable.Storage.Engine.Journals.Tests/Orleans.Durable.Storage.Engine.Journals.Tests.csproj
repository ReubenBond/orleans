<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Debug leg runs the Journals layer's debug assertions here (docs/spec/verification.md §12). -->
  <PropertyGroup>
    <ClogDebugLeg>true</ClogDebugLeg>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Accordant" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.RocksDb\Orleans.Durable.Storage.RocksDb.csproj" />
    <ProjectReference Include="..\fuzz\Orleans.Durable.Storage.Fuzz.Journals\Orleans.Durable.Storage.Fuzz.Journals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\Archive\LiveLedgers.cs;..\shared\Archive\BackpressureTransport.cs;..\shared\Archive\ArchiveChains.cs;..\shared\Archive\KeyedRow.cs;..\shared\Archive\VersionChecker.cs" LinkBase="Archive" />
    <Compile Include="..\shared\Conformance\*.cs" LinkBase="Conformance\Kit" />
    <Compile Include="..\shared\Conformance\Journals\*.cs" LinkBase="Conformance\Kit\Journals" />
    <Compile Include="..\shared\Linearizability\*.cs" LinkBase="Linearizability" />
    <Compile Include="..\shared\CorpusReplay.cs" Link="CorpusReplay.cs" />
    <Compile Include="..\shared\LeakChecks\*.cs" Exclude="..\shared\LeakChecks\SimulationLeakCheck.cs" LinkBase="LeakChecks" />
    <Compile Include="..\shared\SharedVectors.cs" Link="SharedVectors.cs" />
  </ItemGroup>
</Project>
