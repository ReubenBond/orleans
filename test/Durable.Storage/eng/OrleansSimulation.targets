<Project>
  <!--
    Storage's additions to Orleans' simulation build (eng/OrleansSimulation.targets) for an instrumented simulation test
    project (OrleansSimulationInstrumentedTestProject=true). test/Durable.Storage/Directory.Build.targets imports this file
    after Orleans' test targets, which reference the simulation kernel, its framework-neutral and Microsoft Testing
    Platform test support, and the instrumentation task (test/Durable.Storage/docs/spec/build-packaging.md §2).
  -->

  <!--
    The simulation family's projects, the instrumentation task's among them, build in the base configuration, as every
    other consumer and a solution build build them; the simulation configurations define ORLEANS_DURABLE_STORAGE_SIMULATION,
    which only Storage's assemblies read. The task loads from that configuration's output: MSBuild evaluates a UsingTask
    after every property, so this path replaces the one Orleans' simulation targets derive from the project's own
    configuration.
  -->
  <PropertyGroup>
    <OrleansSimulationInstrumentationTaskAssembly>$(OrleansSimulationInstrumentationBuildDirectory)bin\$(DurableStorageBaseConfiguration)\net11.0\Orleans.Testing.Simulation.Instrumentation.Build.dll</OrleansSimulationInstrumentationTaskAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Update="$(SourceRoot)src\Simulation\Orleans.Testing.Simulation\Orleans.Testing.Simulation.csproj;$(SourceRoot)src\Simulation\Orleans.Testing.Simulation.Testing\Orleans.Testing.Simulation.Testing.csproj;$(SourceRoot)src\Simulation\Orleans.Testing.Simulation.Testing.MTP\Orleans.Testing.Simulation.Testing.MTP.csproj;$(OrleansSimulationInstrumentationBuildDirectory)Orleans.Testing.Simulation.Instrumentation.Build.csproj"
                      SetConfiguration="Configuration=$(DurableStorageBaseConfiguration)" />
  </ItemGroup>

  <!--
    A simulation test project compiles against the conditional seams of src, which only the simulation configurations
    compile in (test/Durable.Storage/docs/spec/build-packaging.md §1), so a build in another configuration fails before it compiles.
  -->
  <Target Name="RequireDurableStorageSimulationConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(DurableStorageSimulationBuild)' != 'true'"
           Code="ODS0001"
           Text="$(MSBuildProjectName) is a simulation test project and builds in SimulationRelease or SimulationDebug, not $(Configuration): build it with -c SimulationRelease or -c SimulationDebug, or through Orleans.slnx or test/Durable.Storage/Durable.Storage.slnf, which map Release and Debug to them." />
  </Target>

  <!--
    Storage's test diagnostics (test/Durable.Storage/Directory.Build.props) run in the test host outside every simulation,
    so they keep ordinary IL, as do the test-host assemblies Orleans' simulation targets exclude. So does
    Orleans.Durable.Storage.Diagnostics, which holds the process's fatal-error handler alone, whose interceptor the test
    host installs before every simulation (conventions.md §14): within a simulation it only reads the interceptor and
    calls it. Coverlet would instrument the IL which the simulation rewrites, so simulation projects collect no coverage;
    test/Durable.Storage/eng/coverage.ps1 measures the ordinary suites.
  -->
  <ItemGroup>
    <OrleansSimulationExclude Include="Orleans.Durable.Storage.Diagnostics.dll" />
    <PackageReference Remove="coverlet.MTP" />
  </ItemGroup>

  <!--
    Simulation tests observe the test's cancellation token only in test-host code, each use with its reason: the test
    host cancels the token on its own thread, which would run there, outside the simulation, the callbacks rewritten
    code registered on it (test/Durable.Storage/docs/spec/verification.md §7.1).
  -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Simulation.txt" Link="BannedSymbols.Simulation.txt" Visible="false" />
  </ItemGroup>

  <!--
    The simulation driver of SeededSimulation runs in the test assembly, which keeps ordinary IL, and drives clusters
    of the simulation kit (test/Durable.Storage/Orleans.Durable.Storage.Simulation), which the build rewrites with the rest of the closure. The linked
    sources also make the project run its tests one at a time, since concurrent simulations share static state. The
    driver registers the quiescence and page leak checks (test/Durable.Storage/shared/LeakChecks) as teardown checks; the page check
    reads the Engine's buffer internals, which the Engine grants each simulation test assembly.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\shared\Simulation\*.cs" LinkBase="Simulation" Visible="false" />
    <Compile Include="$(MSBuildThisFileDirectory)..\shared\LeakChecks\SimulationLeakCheck.cs;$(MSBuildThisFileDirectory)..\shared\LeakChecks\ArcBufferLeakCheck.cs;$(MSBuildThisFileDirectory)..\shared\LeakChecks\PageRentalSites.cs"
             LinkBase="LeakChecks"
             Visible="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Orleans.Durable.Storage.Simulation\Orleans.Durable.Storage.Simulation.csproj" />
  </ItemGroup>
</Project>