<Project>
  <!--
    An instrumented simulation test project (OrleansSimulationInstrumentedTestProject=true) consumes Clockwork's
    Microsoft.Orleans.Testing.Simulation packages from its git submodule (vendor/Clockwork) as the packages would supply
    them: the simulation kernel and its framework-neutral testing support, mapped to their source projects by
    eng/OrleansSimulation.SourceBuild.targets, and Microsoft.Orleans.Testing.Simulation.Instrumentation.Build's props
    and targets, whose task assembly builds from source. The project references the Microsoft Testing Platform
    integration (Microsoft.Orleans.Testing.Simulation.Testing.MTP) itself, as a test application does. Directory.Build.targets
    imports this file after the SDK's targets, where the instrumentation targets find the project's output paths. The
    submodule's files are imported once the submodule is initialized, so that a project without it reaches the check in
    eng/Submodules.targets, which names the fix; at an initialized pin, a missing file fails the import
    (docs/spec/build-packaging.md §2).
  -->
  <PropertyGroup>
    <OrleansSimulationInstrumentationBuildDirectory>$(OrleansSimulationSourceRoot)src\Orleans.Testing.Simulation.Instrumentation.Build\</OrleansSimulationInstrumentationBuildDirectory>
    <!-- net11.0 is the task project's own target framework, from Clockwork's build settings, which build it in the base configuration. -->
    <OrleansSimulationInstrumentationTaskAssembly>$(OrleansSimulationInstrumentationBuildDirectory)bin\$(ClogBaseConfiguration)\net11.0\Orleans.Testing.Simulation.Instrumentation.Build.dll</OrleansSimulationInstrumentationTaskAssembly>
  </PropertyGroup>

  <!--
    The task assembly is built in this repository, so each instrumentation runs in a task host process which exits
    afterwards: a long-lived MSBuild node would lock the assembly and keep running a stale build of it. MSBuild uses
    the first UsingTask registered for a task name, so these take precedence over upstream's targets' own.
  -->
  <UsingTask TaskName="Orleans.Testing.Simulation.Instrumentation.Build.OrleansSimulationInstrumentTask"
             AssemblyFile="$(OrleansSimulationInstrumentationTaskAssembly)"
             TaskFactory="TaskHostFactory" />
  <UsingTask TaskName="Orleans.Testing.Simulation.Instrumentation.Build.OrleansSimulationValidateInstrumentedTestTask"
             AssemblyFile="$(OrleansSimulationInstrumentationTaskAssembly)"
             TaskFactory="TaskHostFactory" />

  <ImportGroup Condition="Exists('$(OrleansSimulationSourceRoot).git')">
    <Import Project="$(OrleansSimulationInstrumentationBuildDirectory)build\Microsoft.Orleans.Testing.Simulation.Instrumentation.Build.props" />
    <Import Project="$(OrleansSimulationInstrumentationBuildDirectory)build\Microsoft.Orleans.Testing.Simulation.Instrumentation.Build.targets" />
  </ImportGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Testing.Simulation" />
    <PackageReference Include="Microsoft.Orleans.Testing.Simulation.Testing" />

    <!-- Orders the build of the task assembly before instrumentation; nothing of it is referenced or deployed. -->
    <ProjectReference Include="$(OrleansSimulationInstrumentationBuildDirectory)Orleans.Testing.Simulation.Instrumentation.Build.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SetConfiguration="Configuration=$(ClogBaseConfiguration)" />
  </ItemGroup>

  <!--
    A simulation test project compiles against the conditional seams of src, which only the simulation configurations
    compile in (docs/spec/build-packaging.md §1), so a build in another configuration fails before it compiles.
  -->
  <Target Name="RequireClogSimulationConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(ClogSimulationBuild)' != 'true'"
           Code="CLOG0008"
           Text="$(MSBuildProjectName) is a simulation test project and builds in SimulationRelease or SimulationDebug, not $(Configuration): build it with -c SimulationRelease or -c SimulationDebug, or through Clog.slnx, which maps Release and Debug to them." />
  </Target>

  <!-- A simulation test project is a Microsoft Testing Platform application, which names the platform integration itself. -->
  <Target Name="RequireOrleansSimulationTestingPlatform" BeforeTargets="_GenerateRestoreProjectPathWalk;PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'@(_OrleansSimulationTestingPlatformPackage)' == '' and Exists('$(OrleansSimulationSourceBuildMap)')"
           Code="CLOG0007"
           Text="$(MSBuildProjectName) is a simulation test project and references no Microsoft.Orleans.Testing.Simulation.Testing.MTP, the Microsoft Testing Platform integration its test application needs." />
  </Target>
  <!--
    Clog's test diagnostics (tests/Directory.Build.props) run in the test host outside every simulation, so they keep
    ordinary IL, as do the test-host and simulation-framework assemblies upstream's targets exclude. So does
    Orleans.Durable.Storage.Diagnostics, which holds the process's fatal-error handler alone, whose interceptor the test
    host installs before every simulation (conventions.md §14): within a simulation it only reads the interceptor and
    calls it. Coverlet would instrument the IL which Clockwork rewrites, so simulation
    projects collect no coverage; eng/coverage.ps1 measures the ordinary suites.
  -->
  <ItemGroup>
    <OrleansSimulationExclude Include="Microsoft.Diagnostics.%2A.dll;Orleans.Durable.Storage.Diagnostics.dll" />
    <PackageReference Remove="coverlet.MTP" />
  </ItemGroup>

  <!--
    Simulation tests observe the test's cancellation token only in test-host code, each use with its reason: the test
    host cancels the token on its own thread, which would run there, outside the simulation, the callbacks rewritten
    code registered on it (docs/spec/verification.md §7.1).
  -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Simulation.txt" Link="BannedSymbols.Simulation.txt" Visible="false" />
  </ItemGroup>

  <!--
    The simulation driver of SeededSimulation runs in the test assembly, which keeps ordinary IL, and drives clusters
    of the simulation kit (tests/Orleans.Durable.Storage.Simulation), which the build rewrites with the rest of the closure. The linked
    sources also make the project run its tests one at a time, since concurrent simulations share static state. The
    driver registers the quiescence and page leak checks (tests/shared/LeakChecks) as teardown checks; the page check
    reads the Engine's buffer internals, which the Engine grants each simulation test assembly.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\tests\shared\Simulation\*.cs" LinkBase="Simulation" Visible="false" />
    <Compile Include="$(MSBuildThisFileDirectory)..\tests\shared\LeakChecks\SimulationLeakCheck.cs;$(MSBuildThisFileDirectory)..\tests\shared\LeakChecks\ArcBufferLeakCheck.cs;$(MSBuildThisFileDirectory)..\tests\shared\LeakChecks\PageRentalSites.cs"
             LinkBase="LeakChecks"
             Visible="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\tests\Orleans.Durable.Storage.Simulation\Orleans.Durable.Storage.Simulation.csproj" />
  </ItemGroup>
</Project>
