<Project>
  <!--
    The Durable Storage test infrastructure: its test projects, simulation kit, fuzz targets, benchmarks, and emulator
    host. They take Orleans' test settings (test/Directory.Build.props), then the Storage family's compiler and analyzer
    settings (test/Durable.Storage/eng/durable-storage/Build.props).
  -->
  <PropertyGroup>
    <_ParentDirectoryBuildPropsPath Condition="'$(_DirectoryBuildPropsFile)' != ''">$([System.IO.Path]::Combine('..', '$(_DirectoryBuildPropsFile)'))</_ParentDirectoryBuildPropsPath>
  </PropertyGroup>

  <Import Project="$(_ParentDirectoryBuildPropsPath)" Condition="Exists('$(_ParentDirectoryBuildPropsPath)')"/>

  <Import Project="$(SourceRoot)eng\durable-storage\Build.props" />

  <PropertyGroup>
    <DurableStorageTestRoot>$(MSBuildThisFileDirectory)</DurableStorageTestRoot>
    <IsPackable>false</IsPackable>
    <!-- Storage's tests measure collections and retained memory under the workstation collector they were qualified with. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Verify finds no solution within two levels of these projects; snapshots belong to Orleans.slnx when a project builds alone. -->
    <SolutionDir Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">$(SourceRoot)</SolutionDir>
    <SolutionName Condition="'$(SolutionName)' == '' or '$(SolutionName)' == '*Undefined*'">Orleans</SolutionName>
  </PropertyGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(SourceRoot)eng\durable-storage\DurableStorage.Tests.globalconfig" />
  </ItemGroup>

  <!--
    test/Durable.Storage/eng/validate.ps1 ends a test session which runs past ClogTestSessionTimeout; a project whose
    tests need longer sets its own. A project which sets ClogDebugLeg to true in its project file joins the Debug leg
    (just test-debug), which builds it in Debug so that the debug assertions of the code it tests run
    (test/Durable.Storage/docs/spec/verification.md §12).
  -->
  <PropertyGroup>
    <ClogTestSessionTimeout>12m</ClogTestSessionTimeout>
  </PropertyGroup>

  <!--
    Every test run captures crash, hang, and failure evidence and seeded-simulation histories; see
    test/Durable.Storage/docs/spec/verification.md. testconfig.json enables the crash and hang dump extensions for every
    run of a test application, however it is launched. Microsoft.Diagnostics.NETCore.Client writes failure dumps; the
    test output logger implements the Microsoft.Extensions.Logging abstractions, which the shared framework supplies.
    Orleans' test settings supply the test framework and the crash and hang dump extensions.

    A mutation build (ClogMutationTesting, set by test/Durable.Storage/eng/mutation.ps1) leaves testconfig.json out. The dump extensions
    run the test host beneath a controller process which opens a second server connection, and Stryker.NET's runner
    serves exactly one connection per test application; under mutation, failing and crashing tests are the expected
    outcome, which Stryker records as killed mutants.
  -->
  <ItemGroup Condition="'$(IsOrleansTestApplication)' == 'true'">
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <Using Include="Xunit" />
    <Compile Include="$(MSBuildThisFileDirectory)shared\Diagnostics\*.cs" LinkBase="Diagnostics" Visible="false" />
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Diagnostics\Orleans.Durable.Storage.Diagnostics.csproj" />
    <TestingPlatformBuilderHook Include="25649D24-9BDF-4B33-8887-250631F048E6">
      <DisplayName>Durable Storage test diagnostics</DisplayName>
      <TypeFullName>Orleans.Durable.Storage.Testing.TestDiagnosticsBuilderHook</TypeFullName>
    </TestingPlatformBuilderHook>
  </ItemGroup>
</Project>
