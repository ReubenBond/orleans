<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!--
    A project which checks histories links the linearizability checker and embeds Porcupine's visualization assets
    under the names PorcupineVisualization reads.
  -->
  <ItemGroup>
    <Compile Include="..\shared\SharedVectors.cs" Link="SharedVectors.cs" />
    <!-- The vectors' rejection codes are DecodeRejection's, in the engine. -->
    <ProjectReference Include="..\..\src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
    <Compile Include="..\shared\Linearizability\*.cs" LinkBase="Linearizability" />
    <EmbeddedResource Include="..\shared\Linearizability\Visualization\*"
                      LinkBase="Linearizability\Visualization"
                      LogicalName="Orleans.Durable.Storage.Testing.Linearizability.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
