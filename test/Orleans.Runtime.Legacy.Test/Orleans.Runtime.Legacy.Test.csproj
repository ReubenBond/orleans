<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Runtime.Legacy.Tests</PackageId>
    <Title>Microsoft Orleans Test Legacy Runtime Library</Title>
    <Description>Test library of Microsoft Orleans for legacy runtime support.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Orleans.Runtime.Legacy.Tests</AssemblyName>
    <RootNamespace>Orleans.Runtime.Legacy.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="$(FluentAssertionsVersion)" />
    <PackageReference Include="xunit" Version="$(xUnitVersion)" />
    <PackageReference Include="Xunit.SkippableFact" Version="$(XunitSkippableFactVersion)" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)test\TestInfrastructure\Orleans.TestingHost.Legacy\Orleans.TestingHost.Legacy.csproj" />
    <ProjectReference Include="$(SourceRoot)test\TestInfrastructure\TestExtensions\TestExtensions.csproj" />
    <ProjectReference Include="$(SourceRoot)test\Grains\TestGrains\TestGrains.csproj" />
    <ProjectReference Include="$(SourceRoot)test\Misc\TestInterfaces\TestInterfaces.csproj" />
    <ProjectReference Include="$(SourceRoot)test\Grains\TestInternalGrains\TestInternalGrains.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Update="Hagar" Version="0.2.2-dev-20190409095801" />
    <PackageReference Update="Hagar.CodeGenerator.MSBuild" Version="0.2.2-dev-20190409095801">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
