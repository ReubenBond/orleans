{
  "stryker-config": {
    "project": "Orleans.Durable.Storage.Engine.csproj",
    "test-projects": [
      "../../test/Durable.Storage/Orleans.Durable.Storage.Engine.Ledgers.Tests/Orleans.Durable.Storage.Engine.Ledgers.Tests.csproj"
    ],
    "mutate": [
      "Ledgers/**/*.cs",
      "!Ledgers/ILedgerReplica.cs",
      "!Ledgers/ILedgerReplicaTransport.cs",
      "!Ledgers/ILedgerStore.cs",
      "!Ledgers/LedgerId.cs",
      "!Ledgers/LedgerReplicaCorruptException.cs",
      "!Ledgers/LedgerReplicaFailures.cs",
      "!Ledgers/LedgerReplicaOperations.cs",
      "!Ledgers/LedgerReplicaOptions.cs",
      "!Ledgers/LedgerReplicaQueueTimeoutException.cs",
      "!Ledgers/LedgerReplicaTail.cs",
      "!Ledgers/LedgerStoreClusterMismatchException.cs",
      "!Ledgers/LedgerStorageCorruptException.cs",
      "!Ledgers/NodeId.cs",
      "!Ledgers/ReplicaHeartbeatRead.cs",
      "!Ledgers/ReplicaHeartbeatReply.cs",
      "!Ledgers/ReplicaHeartbeatStatus.cs",
      "!Ledgers/ReplicaRangeRead.cs",
      "!Ledgers/ReplicaRead.cs",
      "!Ledgers/ReplicaTailRead.cs",
      "!Ledgers/ReplicaWriteOutcome.cs",
      "!Ledgers/Slot.cs",
      "!Ledgers/Store/**/*.cs"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "perTestInIsolation",
    "additional-timeout": 60000,
    "ignore-methods": [
      "Meter.CreateCounter",
      "Meter.CreateHistogram",
      "Meter.CreateUpDownCounter"
    ],
    "configuration": "Release",
    "reporters": [
      "json",
      "html",
      "progress"
    ]
  }
}
