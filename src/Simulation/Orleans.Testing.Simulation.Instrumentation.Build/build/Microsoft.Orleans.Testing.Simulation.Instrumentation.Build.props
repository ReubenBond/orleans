<Project>

  <!--
    Microsoft.Orleans.Testing.Simulation.Instrumentation.Build - default properties (imported early).

    Instrumentation is strictly opt-in. Ordinary builds do nothing unless a consumer sets
    OrleansSimulationInstrumentationEnabled=true. All paths below are overridable by the consuming project.
  -->

  <PropertyGroup>
    <!-- Master opt-in switch. Never instrument unless this is explicitly true. -->
    <OrleansSimulationInstrumentationEnabled Condition="'$(OrleansSimulationInstrumentationEnabled)' == ''">false</OrleansSimulationInstrumentationEnabled>
    <!-- Test-project opt-in. The targets turn this into instrumentation plus staged execution. -->
    <OrleansSimulationInstrumentedTestProject Condition="'$(OrleansSimulationInstrumentedTestProject)' == ''">false</OrleansSimulationInstrumentedTestProject>
    <OrleansSimulationInstrumentationMode Condition="'$(OrleansSimulationInstrumentationMode)' == ''">Controlled</OrleansSimulationInstrumentationMode>

    <!--
      Built-in deterministic BCL rule set. Set OrleansSimulationUseBuiltInRules=true to enable the shipped
      deterministic clock/identity/random/crypto rules without authoring JSON.
    -->
    <OrleansSimulationUseBuiltInRules Condition="'$(OrleansSimulationUseBuiltInRules)' == ''">false</OrleansSimulationUseBuiltInRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- When OrleansSimulationUseBuiltInRules is on, enable the first production deterministic BCL rule set. -->
    <OrleansSimulationBuiltInRuleSet Condition="'$(OrleansSimulationUseBuiltInRules)' == 'true'" Include="clockwork.bcl.deterministic" />
  </ItemGroup>

  <!--
    NOTE: The out-of-place staging and manifest paths are intentionally NOT defaulted here.
    They depend on $(IntermediateOutputPath), which the SDK computes after package .props are
    imported. Defaulting them here would bake in an empty prefix (writing to the project root).
    They are defaulted in the accompanying .targets file, which is imported after the SDK props.
  -->

</Project>
