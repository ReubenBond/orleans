<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Roslyn analyzers that flag nondeterministic BCL usage at compile time. Diagnostics mirror the Orleans simulation built-in deterministic rule sets and identify surfaces that require instrumentation.</Description>
    <RootNamespace>Orleans.Testing.Simulation.Analyzers</RootNamespace>
    <AssemblyName>Orleans.Testing.Simulation.Analyzers</AssemblyName>
    <PackageId>Microsoft.Orleans.Testing.Simulation.Analyzers</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <!-- Package validation compares lib/ref framework assets; this package ships its assembly outside them. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Analyzers load into the C# compiler host and must target netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="PackAnalyzerAssembly" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <ItemGroup>
      <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
