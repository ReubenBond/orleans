<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The MetaStore's conditional registers over Fast CASPaxos (Orleans.Consensus.CasPaxos), through a caller-owned register
    service. Remote voters are reached over Orleans RPC by the Orleans-hosted consensus integration, so this package's
    dependency closure holds the consensus kernel and its transport-neutral register services alone.
  -->
  <PropertyGroup>
    <RootNamespace>Orleans.Durable.Storage.CasPaxos</RootNamespace>
    <Title>Microsoft Orleans Durable Storage CASPaxos Metadata Registers</Title>
    <Description>Fast CASPaxos conditional register adapter for the metadata registers of Microsoft Orleans Durable Storage.</Description>
    <PackageTags>$(PackageTags) Consensus CASPaxos</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Consensus\Orleans.Consensus.CasPaxos.Server\Orleans.Consensus.CasPaxos.Server.csproj" />
  </ItemGroup>
</Project>
