<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The process's fatal-error handler (conventions.md §14), the assembly beneath every other: it references no project
    and no package, and simulations leave it ordinary IL (eng/OrleansSimulation.targets).
  -->
  <PropertyGroup>
    <RootNamespace>Orleans.Durable.Storage.Diagnostics</RootNamespace>

    <!-- The fatal-error handler's immediate exit calls _exit and TerminateProcess through source-generated imports. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
