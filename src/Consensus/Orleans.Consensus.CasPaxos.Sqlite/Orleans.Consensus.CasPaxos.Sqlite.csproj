<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Consensus.CasPaxos.Sqlite</PackageId>
    <Description>Durable SQLite keyed acceptors and ballot allocators for Fast CASPaxos replicated registers.</Description>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orleans.Consensus.CasPaxos.Server\Orleans.Consensus.CasPaxos.Server.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <InternalsVisibleTo Include="Orleans.Consensus.CasPaxos.Sqlite.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>