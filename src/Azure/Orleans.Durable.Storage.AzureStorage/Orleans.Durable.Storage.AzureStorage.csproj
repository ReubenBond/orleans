<Project Sdk="Microsoft.NET.Sdk">
  <!-- Azure Storage's providers: Blob object stores, append-blob archive logs, and Table conditional registers. -->
  <PropertyGroup>
    <RootNamespace>Orleans.Durable.Storage.AzureStorage</RootNamespace>
    <Title>Microsoft Orleans Durable Storage Azure Storage Providers</Title>
    <Description>Azure Blob Storage object store and archive-log providers and Azure Table Storage metadata registers for Microsoft Orleans Durable Storage.</Description>
    <PackageTags>$(PackageTags) Azure</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>
</Project>
