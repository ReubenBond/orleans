<Project>

  <ItemGroup>
  <!--
    <ProtoGrainClients Include="@(Protobuf)" Condition="'@(Protobuf->'%(GrainServices).Contains('Client')')' != ''"/>
    <ProtoGrainServers Include="@(Protobuf)" Condition="'@(Protobuf->'%(GrainServices).Contains('Server')')' != ''"/>
    -->
    <AdditionalFiles Include="@(Protobuf)" Condition="'@(Protobuf->'%(GrainServices)')' != ''"/>
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="Protobuf" MetadataName="GrainServices" />

    <CompilerVisibleProperty Include="Orleans_Grpc_CodeGenerator_Clients" />
    <CompilerVisibleProperty Include="Orleans_Grpc_CodeGenerator_Servers" />
  </ItemGroup>

  <PropertyGroup>
    <Orleans_Grpc_CodeGenerator_Clients>@(ProtoGrianClients)</Orleans_Grpc_CodeGenerator_Clients>
    <Orleans_Grpc_CodeGenerator_Servers>@(ProtoGrianServers)</Orleans_Grpc_CodeGenerator_Servers>
  </PropertyGroup>


</Project>