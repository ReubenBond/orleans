<Project>

  <ItemGroup>
    <AdditionalFiles
      Include="@(Protobuf)"
      Condition="'@(Protobuf->'%(GrainServices)')' != ''"/>
      <!--
      GrpcServices="'@(Protobuf->'%(GrpcServices)')'"
      GrainServices="'@(Protobuf->'%(GrainServices)')'"
      AdditionalImportDirs="'@(Protobuf->'%(AdditionalImportDirs)')'"
      -->
  </ItemGroup>

  <ItemGroup>
    <CompilerVisibleItemMetadata Include="Protobuf" MetadataName="GrpcServices" />
    <CompilerVisibleItemMetadata Include="Protobuf" MetadataName="GrainServices" />
    <CompilerVisibleItemMetadata Include="Protobuf" MetadataName="AdditionalImportDirs" />
  </ItemGroup>

</Project>