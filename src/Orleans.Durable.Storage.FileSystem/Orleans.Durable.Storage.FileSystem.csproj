<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The file-system technology package: providers over one host's local file system (the MetaStore's registers and the
    archive's object store), which publish through the WAL's WalFileSystem, the seam whose directory flushes make names
    durable and which crash-state enumeration records.
  -->
  <PropertyGroup>
    <RootNamespace>Orleans.Durable.Storage.FileSystem</RootNamespace>
    <Title>Microsoft Orleans Durable Storage File System Providers</Title>
    <Description>Local file system object store and metadata register providers for Microsoft Orleans Durable Storage.</Description>
    <PackageTags>$(PackageTags) FileSystem</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orleans.Durable.Storage.Engine\Orleans.Durable.Storage.Engine.csproj" />
  </ItemGroup>
</Project>
