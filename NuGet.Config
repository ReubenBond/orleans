<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Feeds to use to restore dependent packages from -->
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="BraggerSpecs" value="https://mscodehub.pkgs.visualstudio.com/BraggerSpecs/_packaging/BraggerSpecs/nuget/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
    </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="BraggerSpecs">
      <package pattern="BraggerSpecs" />
      <package pattern="BraggerSpecs.*" />
    </packageSource>
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>