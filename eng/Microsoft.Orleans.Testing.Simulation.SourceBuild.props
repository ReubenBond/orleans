<Project>
  <!--
    Side-effect-free source-build inventory for the seven Orleans simulation packages.
    Importing this file only declares items; it does not add references, imports, or targets.
  -->
  <ItemGroup>
    <OrleansSimulationSourceBuildPackage Include="Microsoft.Orleans.Testing.Simulation">
      <PackageId>Microsoft.Orleans.Testing.Simulation</PackageId>
      <SourceProject>src/Simulation/Orleans.Testing.Simulation/Orleans.Testing.Simulation.csproj</SourceProject>
      <AssemblyName>Orleans.Testing.Simulation</AssemblyName>
      <TargetFramework>net11.0</TargetFramework>
      <Role>SimulationKernel</Role>
    </OrleansSimulationSourceBuildPackage>
    <OrleansSimulationSourceBuildPackage Include="Microsoft.Orleans.Testing.Simulation.Instrumentation">
