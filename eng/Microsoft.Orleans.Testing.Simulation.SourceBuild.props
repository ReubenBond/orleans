    </OrleansSimulationSourceBuildPackage>
    <OrleansSimulationSourceBuildPackage Include="Microsoft.Orleans.Testing.Simulation.Testing.MTP">
      <PackageId>Microsoft.Orleans.Testing.Simulation.Testing.MTP</PackageId>
      <SourceProject>src/Simulation/Orleans.Testing.Simulation.Testing.MTP/Orleans.Testing.Simulation.Testing.MTP.csproj</SourceProject>
