    </OrleansSimulationSourceBuildPackage>
    <OrleansSimulationSourceBuildPackage Include="Microsoft.Orleans.Testing.Simulation.Testing">
      <PackageId>Microsoft.Orleans.Testing.Simulation.Testing</PackageId>
      <SourceProject>src/Simulation/Orleans.Testing.Simulation.Testing/Orleans.Testing.Simulation.Testing.csproj</SourceProject>
      <AssemblyName>Orleans.Testing.Simulation.Testing</AssemblyName>
      <TargetFramework>net11.0</TargetFramework>
