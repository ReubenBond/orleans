<Project>
  <!--
    The Durable Storage family's build targets, imported after Orleans' targets by src/Directory.Build.targets,
    test/Durable.Storage/Directory.Build.targets, and playground/DurableStorage/Directory.Build.targets.
  -->

  <!--
    Orleans' build targets add Orleans namespaces to the implicit global usings after the project's items; removing them
    keeps Orleans' names, such as its FatalErrorHandler, from shadowing Storage's in every project which reaches Orleans.
  -->
  <Target Name="ClogRemoveOrleansUsings" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="Orleans" />
      <Using Remove="Orleans.Hosting" />
      <Using Remove="Orleans.Runtime" />
    </ItemGroup>
  </Target>

  <!--
    Only a project which builds Orleans grains or serializers (OrleansBuildTimeCodeGen) is an Orleans framework part;
    the Engine, Diagnostics, and the technology providers name no Orleans type.
  -->
  <ItemGroup Condition="'$(OrleansBuildTimeCodeGen)' != 'true'">
    <AssemblyAttribute Remove="Orleans.Metadata.FrameworkPartAttribute" />
  </ItemGroup>

  <!--
    A simulation configuration builds Storage's whole closure in itself (test/Durable.Storage/docs/spec/build-packaging.md
    §1). In a solution build, MSBuild assigns each project reference the configuration the solution maps the referenced
    project to, Release or Debug for a src project, so the Storage references of a project which builds in a simulation
    configuration take its own again; references to other families keep the configuration MSBuild assigns them.
  -->
  <Target Name="ClogKeepSimulationConfiguration" AfterTargets="AssignProjectConfiguration" Condition="'$(ClogSimulationBuild)' == 'true'">
    <ItemGroup>
      <_ClogSimulationReference Include="@(ProjectReferenceWithConfiguration)"
                                Condition="$([System.String]::Copy('%(Filename)').StartsWith('Orleans.Durable.Storage', System.StringComparison.Ordinal))" />
      <ProjectReferenceWithConfiguration Remove="@(_ClogSimulationReference)" />
      <ProjectReferenceWithConfiguration Include="@(_ClogSimulationReference)" Configuration="$(Configuration)" SetConfiguration="Configuration=$(Configuration)" />
    </ItemGroup>
  </Target>
</Project>